{
  "name": "vibe-prompting",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/vibe-prompting/index.ts",
    "./server": "./src/vibe-prompting/server.ts"
  },
  "scripts": {
    "db:setup": "node src/vibe-prompting/app/setup-db.ts",
    "dev": "concurrently --kill-others-on-fail --names frontend,api,mcp \"pnpm run frontend:dev\" \"pnpm run server:dev\" \"pnpm run mcp:dev\"",
    "frontend:build": "pnpm --dir frontend build",
    "frontend:dev": "pnpm --dir frontend dev",
    "frontend:start": "pnpm --dir frontend start",
    "frontend:typecheck": "pnpm --dir frontend typecheck",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "graph:dev": "langgraphjs dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "mcp": "node src/vibe-prompting/app/mcp.ts",
    "mcp:dev": "node --watch --watch-preserve-output src/vibe-prompting/app/mcp.ts",
    "server": "node src/vibe-prompting/app/api.ts",
    "server:dev": "node --watch --watch-preserve-output src/vibe-prompting/app/api.ts",
    "test-agent": "node test_agent.ts",
    "test-agent:ui": "node test_agent.ts --ui",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@ai-sdk/google": "3.0.31",
    "@ai-sdk/mcp": "1.0.21",
    "@ai-sdk/openai": "3.0.33",
    "@ai-sdk/openai-compatible": "2.0.30",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.5.6",
    "@langfuse/client": "^5.10.0",
    "@langfuse/otel": "5.10.0",
    "@langfuse/tracing": "5.10.0",
    "@openai/agents": "0.16.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@prefecthq/fastmcp-ts": "1.5.1",
    "ai": "6.0.138",
    "dotenv": "17.3.1",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "lucide-react": "^0.468.0",
    "postgres": "3.4.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.4.4",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "^7.0.2"
  }
}
