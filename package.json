{
  "name": "vibe-prompting",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/vibe-prompting/index.ts",
    "./mcp": "./src/vibe-prompting/app/mcp.ts",
    "./server": "./src/vibe-prompting/server.ts"
  },
  "scripts": {
    "db:seed-example": "node scripts/seed-default-workspace.ts",
    "db:setup": "node --env-file-if-exists=.env src/vibe-prompting/app/setup-db.ts",
    "dev": "concurrently --kill-others-on-fail --names frontend,api \"pnpm run frontend:dev\" \"pnpm run server:dev\"",
    "frontend:build": "pnpm --dir frontend build",
    "frontend:dev": "pnpm --dir frontend dev",
    "frontend:start": "pnpm --dir frontend start",
    "frontend:typecheck": "pnpm --dir frontend typecheck",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "graph:dev": "langgraphjs dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "mcp": "node src/vibe-prompting/app/mcp.ts",
    "mcp:dev": "node --watch-path=src/vibe-prompting --watch-preserve-output src/vibe-prompting/app/mcp.ts",
    "server": "node src/vibe-prompting/app/api.ts",
    "server:dev": "API_PORT=${API_PORT:-0} node --watch --watch-preserve-output src/vibe-prompting/app/api.ts",
    "test:multiuser": "node --env-file-if-exists=.env scripts/multiuser-stress.ts",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@ai-sdk/google": "4.0.50",
    "@ai-sdk/mcp": "2.0.36",
    "@ai-sdk/openai": "4.0.46",
    "@ai-sdk/openai-compatible": "3.0.35",
    "@ai-sdk/otel": "1.0.77",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@langchain/openai": "^1.5.10",
    "@langfuse/client": "^5.10.1",
    "@langfuse/otel": "5.10.1",
    "@langfuse/tracing": "5.10.1",
    "@openai/agents": "0.17.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@prefecthq/fastmcp-ts": "1.6.0",
    "ai": "7.0.77",
    "dotenv": "17.4.2",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "lucide-react": "^1.33.0",
    "postgres": "3.4.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.4.5",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "^7.0.2"
  }
}
