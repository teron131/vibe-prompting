# Models assigned to CLIProxyAPI use this local OpenAI-compatible endpoint.
CLIPROXYAPI_BASE_URL=http://localhost:8317/v1
CLIPROXYAPI_API_KEY=

# Gemini chat and embeddings use Google AI directly.
GEMINI_API_KEY=

# Set both values to enable the optional deployment-wide model spend circuit breaker.
MODEL_SPEND_LIMIT_USD=
MODEL_SPEND_WINDOW_HOURS=

# Any model family may fall back to this OpenAI-compatible endpoint.
LLM_BASE_URL=
LLM_API_KEY=

# Exa runs through its remote HTTP MCP server; the key is optional for the hosted free allowance.
EXA_API_KEY=

# Prompt revisions are stored in PostgreSQL; this local URL can be replaced with any hosted PostgreSQL connection URL.
DATABASE_URL=postgresql://localhost/vibe_prompting

# The destructive multiuser stress harness accepts only a separate database whose name ends in _test.
TEST_DATABASE_URL=postgresql://localhost/vibe_prompting_test

# Google OpenID Connect identifies users, and the callback URL is APP_BASE_URL plus /api/auth/google/callback.
APP_BASE_URL=http://localhost:8001
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# New Google identities enter one long, randomly generated invitation code before their membership becomes active.
INVITATION_CODE=

# BYOK credentials use a machine-local development key by default; deployed credential saving requires a stable dedicated key.
BYOK_ENCRYPTION_KEY=

# Set both Langfuse keys to persist experiments and traces; leave both blank to return results without Langfuse persistence.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
