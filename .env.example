# Models assigned to CLIProxyAPI use this local OpenAI-compatible endpoint.
CLIPROXYAPI_BASE_URL=http://localhost:8317/v1
CLIPROXYAPI_API_KEY=

# Gemini chat and embeddings use Google AI directly.
GEMINI_API_KEY=

# Set both values to enable the optional deployment-wide model spend circuit breaker.
MODEL_SPEND_LIMIT_USD=
MODEL_SPEND_WINDOW_HOURS=

# Any model family may fall back to this OpenAI-compatible endpoint.
LLM_BASE_URL=
LLM_API_KEY=

# Exa runs through its remote HTTP MCP server; the key is optional for the hosted free allowance.
EXA_API_KEY=

# Prompt revisions are stored in PostgreSQL; this local URL can be replaced with any hosted PostgreSQL connection URL.
DATABASE_URL=postgresql://localhost/vibe_prompting

# BYOK credentials use a machine-local development key by default; set a stable secret for deployed encryption instead of coupling saved credentials to APP_PASSWORD rotation.
BYOK_ENCRYPTION_KEY=

# Set both Langfuse keys to persist experiments and traces; leave both blank to return results without Langfuse persistence.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
